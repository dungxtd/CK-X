{
  "policies": {
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "DontCheckDefaultBrowser": true,
    "DisableProfileImport": true,
    "DisableTelemetry": true,
    "DisableFirefoxAccounts": true,
    "DisableFirefoxStudies": true,
    "DisableFeedbackCommands": true,
    "NoDefaultBookmarks": true,
    "Homepage": {
      "URL": "https://docs.linuxfoundation.org/tc-docs/certification/certification-resources-allowed",
      "StartPage": "homepage",
      "Locked": false
    },
    "FirefoxHome": {
      "Search": true,
      "TopSites": false,
      "SponsoredTopSites": false,
      "Stories": false,
      "SponsoredStories": false,
      "Highlights": false,
      "Snippets": false,
      "Weather": false,
      "Widgets": {
        "Enabled": false
      }
    },
    "UserMessaging": {
      "WhatsNew": false,
      "ExtensionRecommendations": false,
      "FeatureRecommendations": false,
      "UrlbarInterventions": false,
      "MoreFromMozilla": false,
      "SkipOnboarding": true
    },
    "Preferences": {
      "browser.aboutwelcome.enabled": false,
      "datareporting.policy.dataSubmissionPolicyBypassNotification": true
    },
    "WebsiteFilter": {
      "Block": [
        "<all_urls>"
      ],
      "Exceptions": [
        "https://docs.linuxfoundation.org/tc-docs/certification/certification-resources-allowed*",
        "https://kubernetes.io/docs*",
        "https://kubernetes.io/*/docs*",
        "https://kubernetes.io/blog*",
        "https://kubernetes.io/search*",
        "https://helm.sh/docs*",
        "https://gateway-api.sigs.k8s.io/*",
        "https://falco.org/docs*",
        "https://kubernetes-sigs.github.io/bom/cli-reference*",
        "https://etcd.io/docs*",
        "https://kubernetes.github.io/ingress-nginx/*",
        "https://docs.cilium.io/*",
        "https://istio.io/latest/docs*"
      ]
    }
  }
}
