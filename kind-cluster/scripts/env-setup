#!/bin/sh
exec >> /proc/1/fd/1 2>&1
# ===============================================================================
#   Exam cluster creation (kind / kubeadm)
#   Usage:   env-setup --cluster NAME:WORKERS [--cluster NAME:WORKERS ...]
#   Example: env-setup --cluster k8s:2 --cluster k8s-b:1
#
#   Each cluster gets a kubeconfig context named after it (the first one is
#   current), and every node is reachable over ssh by its node name from the
#   jumphost. Host ports on k8s-api-server for cluster N (0-based):
#     API 6443+N, etcd 2379+N, node ssh 2200+10*N+i (i=0 control plane)
# ===============================================================================

. /etc/ckx.env
KUBE_DIR=/home/candidate/.kube
SHARE=/usr/local/share/ckx
CLUSTERS=""

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') | $1"; }

while [ $# -gt 0 ]; do
    case "$1" in
        --cluster) CLUSTERS="$CLUSTERS $2"; shift 2 ;;
        *) log "ERROR: unknown argument: $1"; exit 1 ;;
    esac
done

[ -n "$CLUSTERS" ] || { log "ERROR: at least one --cluster NAME:WORKERS is required"; exit 1; }
for spec in $CLUSTERS; do
    case "$spec" in
        [a-z]*:[0-9]) ;;
        *) log "ERROR: invalid --cluster '$spec' (NAME:WORKERS, 0-9 workers)"; exit 1 ;;
    esac
    case "${spec%%:*}" in
        *[!a-z0-9-]*) log "ERROR: invalid cluster name in '$spec'"; exit 1 ;;
    esac
done

# kind config for one cluster: $1 name, $2 workers, $3 index
kind_config() {
    cat <<EOF
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  apiServerAddress: "0.0.0.0"
  apiServerPort: $((6443 + $3))
containerdConfigPatches:
  - |-
    [plugins."io.containerd.cri.v1.images".registry]
      config_path = "/etc/containerd/certs.d"
nodes:
  - role: control-plane
    kubeadmConfigPatches:
      - |
        kind: ClusterConfiguration
        apiServer:
          certSANs: ["k8s-api-server"]
        etcd:
          local:
            serverCertSANs: ["k8s-api-server"]
    extraPortMappings:
      - { containerPort: 2379, hostPort: $((2379 + $3)) }
      - { containerPort: 22, hostPort: $((2200 + 10 * $3)) }
    extraMounts:
      - { hostPath: $SHARE/certs.d, containerPath: /etc/containerd/certs.d, readOnly: true }
EOF
    i=1
    while [ $i -le "$2" ]; do
        cat <<EOF
  - role: worker
    extraPortMappings:
      - { containerPort: 22, hostPort: $((2200 + 10 * $3 + i)) }
    extraMounts:
      - { hostPath: $SHARE/certs.d, containerPath: /etc/containerd/certs.d, readOnly: true }
EOF
        i=$((i + 1))
    done
}

# Clusters from an exam that was never cleaned up survive restarts on the
# dind-data volume; start from a clean slate
for old in $(kind get clusters 2>/dev/null); do
    log "Deleting leftover cluster '$old'"
    kind delete cluster --name "$old"
done
rm -rf "$KUBE_DIR/kubeconfig" "$KUBE_DIR/config" "$KUBE_DIR/etcd-certs" "$KUBE_DIR/ssh_config" "$KUBE_DIR"/clusters
mkdir -p "$KUBE_DIR/clusters"

# Create all clusters in parallel
index=0
for spec in $CLUSTERS; do
    name=${spec%%:*}; workers=${spec#*:}
    log "Creating cluster '$name' (1 control plane + $workers workers)"
    kind_config "$name" "$workers" "$index" > "/tmp/kind-$name.yaml"
    kind create cluster --name "$name" --image "$CKX_NODE_IMAGE" \
        --config "/tmp/kind-$name.yaml" --kubeconfig "/tmp/kind-$name.kubeconfig" --wait 120s > "/tmp/kind-$name.log" 2>&1 &
    echo $! > "/tmp/kind-$name.pid"
    index=$((index + 1))
done

FAILED=0
for spec in $CLUSTERS; do
    name=${spec%%:*}
    if wait "$(cat "/tmp/kind-$name.pid")"; then
        log "Cluster '$name' created"
    else
        log "ERROR: creating cluster '$name' failed:"; cat "/tmp/kind-$name.log"
        FAILED=1
    fi
done
[ "$FAILED" = 0 ] || exit 1

# Per-cluster kubeconfig (API via k8s-api-server, context named after the
# cluster), ssh aliases for every node, and metrics-server
index=0
for spec in $CLUSTERS; do
    name=${spec%%:*}
    kind get kubeconfig --name "$name" \
        | sed -e "s|https://0.0.0.0:|https://k8s-api-server:|" -e "s/kind-$name/$name/g" \
        > "$KUBE_DIR/clusters/$name"

    for node in $(kind get nodes --name "$name" | sort); do
        case "$node" in
            *-control-plane) port=$((2200 + 10 * index)) ;;
            *-worker) port=$((2200 + 10 * index + 1)) ;;
            *) port=$((2200 + 10 * index + ${node##*-worker})) ;;
        esac
        printf 'Host %s\n  HostName k8s-api-server\n  Port %s\n  User root\n\n' "$node" "$port" \
            >> "$KUBE_DIR/ssh_config"
    done

    docker exec -i "$name-control-plane" kubectl --kubeconfig /etc/kubernetes/admin.conf \
        apply -f - < "$SHARE/metrics-server.yaml" > /dev/null
    index=$((index + 1))
done

KUBECONFIG=$(ls "$KUBE_DIR"/clusters/* | tr '\n' ':') kubectl config view --flatten > "$KUBE_DIR/kubeconfig"
FIRST=$(echo $CLUSTERS | cut -d' ' -f1); FIRST=${FIRST%%:*}
kubectl --kubeconfig "$KUBE_DIR/kubeconfig" config use-context "$FIRST" > /dev/null
# Default kubeconfig location too, so kubectl works without KUBECONFIG
ln -s kubeconfig "$KUBE_DIR/config"
rm -rf "$KUBE_DIR/clusters"

# etcd client certs of the first cluster for etcdctl on the jumphost
etcd-export-certs "$FIRST-control-plane"

chmod 644 "$KUBE_DIR/kubeconfig" "$KUBE_DIR/ssh_config"
log "Cluster setup done: $(kubectl --kubeconfig "$KUBE_DIR/kubeconfig" config get-contexts -o name | tr '\n' ' ')"
exit 0
