#!/bin/sh
exec >> /proc/1/fd/1 2>&1
# ===============================================================================
#   Export the etcd CA and a client cert from a kubeadm control-plane node to
#   the shared kube volume, so the jumphost can run etcdctl against
#   https://k8s-api-server:2379.
#   Usage: etcd-export-certs CONTROL_PLANE_CONTAINER
# ===============================================================================

NODE=$1
DEST=/home/candidate/.kube/etcd-certs
PKI=/etc/kubernetes/pki/etcd

mkdir -p "$DEST"
if docker cp "$NODE:$PKI/ca.crt" "$DEST/ca.crt" \
    && docker cp "$NODE:$PKI/healthcheck-client.crt" "$DEST/client.crt" \
    && docker cp "$NODE:$PKI/healthcheck-client.key" "$DEST/client.key"; then
    chmod 644 "$DEST"/*
    echo "$(date '+%Y-%m-%d %H:%M:%S') | etcd TLS certs exported to $DEST"
else
    echo "$(date '+%Y-%m-%d %H:%M:%S') | WARNING: could not export etcd TLS certs from $NODE"
fi
exit 0
