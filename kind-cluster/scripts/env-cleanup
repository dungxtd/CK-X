#!/bin/sh
exec >> /proc/1/fd/1 2>&1
# ===============================================================================
#   Delete every exam cluster and the files env-setup shared with the jumphost.
#   Node images and the registry caches are kept for the next exam.
#   Usage: env-cleanup
# ===============================================================================

for cluster in $(kind get clusters 2>/dev/null); do
    kind delete cluster --name "$cluster"
done

# Anonymous volumes and dangling images left by the deleted nodes
docker volume prune -f > /dev/null
docker image prune -f > /dev/null

rm -rf /home/candidate/.kube/kubeconfig /home/candidate/.kube/etcd-certs /home/candidate/.kube/ssh_config

echo "$(date '+%Y-%m-%d %H:%M:%S') | Cleanup completed."
exit 0
